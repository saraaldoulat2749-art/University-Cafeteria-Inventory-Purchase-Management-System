@model Category

@{
    ViewData["Title"] = "Create";
}

<h2>Create Category</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="NameC"></label>
        <input asp-for="NameC" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="DescriptionC"></label>
        <input asp-for="DescriptionC" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>