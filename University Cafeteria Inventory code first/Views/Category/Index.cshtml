@model List<Category> 

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">NameC</th>
            <th scope="col">DescriptionC</th>
            <th scope="col">Product Count</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
      @foreach(var category in Model)
      {
          <tr>
              <td>@category.Id</td>
              <td>@category.NameC</td>
              <td>@category.DescriptionC</td>
                <td>@category.Products.Count</td>

              <td>
                  <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-primary">Edit</a>
                  <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger">Delete</a>
                    <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-info">Details</a>

              </td>

          </tr>
      }
      <button><a asp-action="Create" class="btn btn-success">Create New Category</a></button>
    </tbody>
</table>
