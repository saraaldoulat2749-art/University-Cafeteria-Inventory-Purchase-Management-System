@model Product

@{
    ViewData["Title"] = "Create";
}

<h2>Create Product</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="NameP"></label>
        <input asp-for="NameP" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Quantity"></label>
        <input asp-for="Quantity" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" class="form-control" 
                name="CategoryId">
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id">@category.NameC</option>
            }
            <option value="">Select Category</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="SupplierId"></label>
        <select asp-for="SupplierId" class="form-control" 
                name="SupplierId">
            @foreach (var supplier in ViewBag.Suppliers)
            {
                <option value="@supplier.Id">@supplier.NameS</option>
            }
            <option value="">Select Supplier</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>